print(heap_sort([4, 10, 3, 5, 1]))
print(heap_sort([1, 2, 3, 4, 5]))
print(heap_sort([5, 4, 3, 2, 1]))
print(heap_sort([4, 2, 4, 1, 2]))
print(heap_sort([]))

